# ============================================================
# PitchLink backend configuration
# Copy this file to ".env" and fill in your real values.
# ============================================================

# --- Server ---
PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# --- Africa's Talking (SANDBOX) ---
# 1. Create a free account: https://account.africastalking.com/auth/register
# 2. Go to your Sandbox app -> "Settings" -> "API Key" to generate a key.
#    Docs: https://developers.africastalking.com/docs/account/generate_api_key
# 3. Username for sandbox is ALWAYS the literal string "sandbox"
#    (not your account email or company name).
AT_USERNAME=sandbox
AT_API_KEY=PASTE_YOUR_SANDBOX_API_KEY_HERE

# Sandbox SMS sender: leave blank to use the shared shortcode "AFRICASTKNG".
# In production you'd request a dedicated Sender ID/Shortcode from AT.
AT_SMS_SENDER_ID=

# USSD service code assigned to your sandbox app, e.g. "*384*XXXX#"
# Found in: Sandbox app -> USSD -> "Create channel"
# Docs: https://developers.africastalking.com/docs/ussd/overview
AT_USSD_SERVICE_CODE=*384*00000#

# Voice: the phone number AT gives your sandbox app for outbound calls
# Found in: Sandbox app -> Voice -> Phone numbers
# Docs: https://developers.africastalking.com/docs/voice/overview
AT_VOICE_CALLER_ID=+254700000000

# --- Callback / webhook URL ---
# Africa's Talking calls YOUR backend over the public internet for:
#   - USSD session updates -> POST {PUBLIC_URL}/api/ussd
#   - Incoming SMS replies  -> POST {PUBLIC_URL}/api/sms/inbound
#   - SMS delivery reports   -> POST {PUBLIC_URL}/api/sms/delivery
#   - Voice call events    -> POST {PUBLIC_URL}/api/voice/events
# Your laptop's localhost is NOT reachable from AT's servers, so during
# development you must tunnel it, e.g. with ngrok:
#
#   npx ngrok http 4000
#
# ngrok prints a URL like: https://a1b2-41-90-64-1.ngrok-free.app
# Paste that here AND register it in the AT Sandbox dashboard:
#   - USSD:  Sandbox app -> USSD -> your channel -> "Callback URL"      -> {PUBLIC_URL}/api/ussd
#   - Voice: Sandbox app -> Voice -> your number -> "Callback URL"      -> {PUBLIC_URL}/api/voice/events
#   - SMS delivery reports (optional): Sandbox app -> SMS -> "Delivery Reports Callback URL"
PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app
